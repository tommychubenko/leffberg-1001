+    uint32_t take = n < room ? n : room;
+    memcpy(&s_pd_buf[s_pd_fill], x, take * sizeof(int16_t));
+    s_pd_fill += take;
+    if (s_pd_fill >= PCM_DUMP_SAMPLES) {
