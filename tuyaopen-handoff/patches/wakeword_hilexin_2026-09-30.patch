+#if ENABLE_MIC_FREQ_RESP_TEST
+/* Speaker -> mic acoustic frequency response: play a tone ladder through the amp and
+ * log, once per second, the mic amplitude at each ladder frequency (Goertzel). */
+#define FRT_NUM_FREQ (6)
+static const int s_frt_freq[FRT_NUM_FREQ] = {300, 500, 1000, 2000, 3000, 4000};
+static volatile bool s_frt_active = false;
+static struct {
+    float coeff[FRT_NUM_FREQ];
+    float s1[FRT_NUM_FREQ], s2[FRT_NUM_FREQ];
+    uint64_t sq;
+    uint32_t n;
+    bool inited;
+} s_frt;
+
+static void __frt_mic_feed(const int16_t *x, uint32_t n)
+{
+    if (!s_frt_active) {
+        return;
+    }
+    if (!s_frt.inited) {
+        for (int k = 0; k < FRT_NUM_FREQ; k++) {
+            s_frt.coeff[k] = 2.0f * cosf(2.0f * 3.14159265f * (float)s_frt_freq[k] / 16000.0f);
+        }
+        s_frt.inited = true;
+    }
+    for (uint32_t i = 0; i < n; i++) {
+        float v = (float)x[i];
+        s_frt.sq += (uint64_t)(x[i] * x[i]);
+        for (int k = 0; k < FRT_NUM_FREQ; k++) {
+            float s = v + s_frt.coeff[k] * s_frt.s1[k] - s_frt.s2[k];
+            s_frt.s2[k] = s_frt.s1[k];
+            s_frt.s1[k] = s;
+        }
+    }
+    s_frt.n += n;
+    if (s_frt.n >= 8000u) { /* 0.5 s windows */
+        int amp[FRT_NUM_FREQ];
+        for (int k = 0; k < FRT_NUM_FREQ; k++) {
+            float p = s_frt.s1[k] * s_frt.s1[k] + s_frt.s2[k] * s_frt.s2[k] - s_frt.coeff[k] * s_frt.s1[k] * s_frt.s2[k];
+            amp[k] = (int)(sqrtf(p < 0.0f ? 0.0f : p) * 2.0f / (float)s_frt.n);
+            s_frt.s1[k] = s_frt.s2[k] = 0.0f;
+        }
+        PR_NOTICE("mic resp: rms=%d | 300=%d 500=%d 1000=%d 2000=%d 3000=%d 4000=%d",
+                  (int)sqrt((double)s_frt.sq / (double)s_frt.n), amp[0], amp[1], amp[2], amp[3], amp[4], amp[5]);
+        s_frt.n = 0;
+        s_frt.sq = 0;
+    }
