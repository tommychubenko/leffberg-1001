+
+static void __mic_hpf_init(uint32_t fs)
+{
+    float w0 = 2.0f * 3.14159265f * MIC_HPF_FC_HZ / (float)fs;
+    float cw = cosf(w0), sw = sinf(w0);
+    float alpha = sw / (2.0f * 0.7071f);
+    float a0 = 1.0f + alpha;
+    s_hpf.b0 = ((1.0f + cw) * 0.5f) / a0;
+    s_hpf.b1 = (-(1.0f + cw)) / a0;
+    s_hpf.b2 = s_hpf.b0;
+    s_hpf.a1 = (-2.0f * cw) / a0;
+    s_hpf.a2 = (1.0f - alpha) / a0;
+    s_hpf.x1 = s_hpf.x2 = s_hpf.y1 = s_hpf.y2 = 0.0f;
+    s_hpf.inited = true;
+    PR_NOTICE("mic HPF: 2nd-order %d Hz @ %u Hz (applied on 24-bit data before the >>14 clip)", (int)MIC_HPF_FC_HZ,
+              (unsigned)fs);
+}
+
+/* One sample through the biquad; input/output in the same (24-bit) scale. */
+static inline float __mic_hpf_sample(float xin)
+{
+    float y = s_hpf.b0 * xin + s_hpf.b1 * s_hpf.x1 + s_hpf.b2 * s_hpf.x2 - s_hpf.a1 * s_hpf.y1 - s_hpf.a2 * s_hpf.y2;
+    s_hpf.x2 = s_hpf.x1;
+    s_hpf.x1 = xin;
+    s_hpf.y2 = s_hpf.y1;
+    s_hpf.y1 = y;
+    return y;
+}
