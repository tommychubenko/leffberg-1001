+            line[o] = 0;
+            fputs(line, stdout);
+            if ((off / 72) % 16 == 15) {
+                tal_system_sleep(2); /* let other tasks log; UART is the bottleneck anyway */
+            }
+        }
+        fflush(stdout);
+        s_pd_shots++;
+        PR_NOTICE("pcm dump: end shot %u", (unsigned)s_pd_shots);
+        s_pd_ready = false;
+    }
+}
