+        uint32_t total = PCM_DUMP_SAMPLES * sizeof(int16_t);
+        PR_NOTICE("pcm dump: begin shot %u, %u bytes, 16 kHz s16le mono", (unsigned)(s_pd_shots + 1), (unsigned)total);
+        tal_system_sleep(50);
+        for (uint32_t off = 0; off < total; off += 72) {
+            uint32_t chunk = (total - off) < 72 ? (total - off) : 72;
+            int o = 0;
+            memcpy(line, "PCMD:", 5);
+            o = 5;
+            for (uint32_t i = 0; i < chunk; i += 3) {
+                uint32_t b0 = p[off + i];
+                uint32_t b1 = (i + 1 < chunk) ? p[off + i + 1] : 0;
+                uint32_t b2 = (i + 2 < chunk) ? p[off + i + 2] : 0;
