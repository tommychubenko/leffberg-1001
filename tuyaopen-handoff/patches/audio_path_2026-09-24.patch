+/*
+ * Local PCM chime (connect / boot).
+ *
+ * Synthesised in 20 ms chunks straight into tdl_audio_play(). The previous
+ * version tal_malloc'ed a whole note (14-18 KB of *internal* RAM); with ~30 KB
+ * of fragmented internal heap left that failed with OPRT_MALLOC_FAILED
+ * (COM: "AUDIO DEBUG B done rt=-3"), so only one note was ever heard.
+ */
+#define CHIME_SAMPLE_RATE (16000)
+#define CHIME_CHUNK_SAMPLES (320) /* 20 ms */
+#define CHIME_ATTACK_MS (5)
+
+/** One decaying bell-like note (fundamental + 2nd/3rd harmonic), streamed in chunks. */
+static OPERATE_RET __pcm_play_note(TDL_AUDIO_HANDLE_T spk, float hz, int ms, float amp)
+{
+    int16_t buf[CHIME_CHUNK_SAMPLES];
+    const int total = CHIME_SAMPLE_RATE * ms / 1000;
+    const int attack = CHIME_SAMPLE_RATE * CHIME_ATTACK_MS / 1000;
+    const float w = 2.0f * 3.14159265f * hz / (float)CHIME_SAMPLE_RATE;
+    /* Exponential decay down to ~-20 dB at the end of the note. */
+    const float decay = (hz > 0.0f) ? expf(logf(0.10f) / (float)total) : 1.0f;
+    float ph = 0.0f;
+    float env = 1.0f;
+    int done = 0;
+    OPERATE_RET rt = OPRT_OK;
+
+    while (done < total && rt == OPRT_OK) {
+        int n = total - done;
+        if (n > CHIME_CHUNK_SAMPLES) {
+            n = CHIME_CHUNK_SAMPLES;
+        }
+        for (int i = 0; i < n; i++, done++) {
+            if (hz <= 0.0f) { /* silence gap */
+                buf[i] = 0;
+                continue;
+            }
+            float s = sinf(ph) * 0.70f + sinf(2.0f * ph) * 0.20f + sinf(3.0f * ph) * 0.10f;
+            float a = env;
+            if (done < attack) {
+                a *= (float)done / (float)attack;
+            }
+            buf[i] = (int16_t)(s * a * amp);
+            ph += w;
+            if (ph > 6.2831853f) {
+                ph -= 6.2831853f;
+            }
+            env *= decay;
+        }
+        rt = tdl_audio_play(spk, (uint8_t *)buf, (uint32_t)n * sizeof(int16_t));
+    }
+    return rt;
+}
+
+/** Two-note "ding-dong": 659 Hz then 523 Hz, short silence in between. */
+static OPERATE_RET __play_pcm_connect_chime(void)
+{
+    TDL_AUDIO_HANDLE_T spk = NULL;
+    int user_vol = 100;
+    OPERATE_RET rt = OPRT_OK;
+
+    if (tdl_audio_find(AUDIO_CODEC_NAME, &spk) != OPRT_OK || !spk) {
+        PR_ERR("pcm chime: no speaker");
+        return OPRT_COM_ERROR;
+    }
+
+    /* Chime at full scale, then give the user volume back to the speaker driver. */
+    ai_audio_player_get_vol(&user_vol);
+    tdl_audio_volume_set(spk, 100);
+    /* Doorbell-style E5 -> C5; lower and longer than 880/659 so it is not heard as a "beep". */
+    PR_NOTICE("audio player -> PCM ding-dong 659 then 523 Hz");
+
+    rt = __pcm_play_note(spk, 659.0f, 450, 24000.0f);
+    if (rt == OPRT_OK) {
+        rt = __pcm_play_note(spk, 0.0f, 100, 0.0f);
+    }
+    if (rt == OPRT_OK) {
+        rt = __pcm_play_note(spk, 523.0f, 650, 24000.0f);
+    }
+    if (rt != OPRT_OK) {
+        PR_ERR("pcm chime play failed rt=%d", rt);
+    }
+
+    tdl_audio_volume_set(spk, (uint8_t)user_vol);
+    return rt;
+}
