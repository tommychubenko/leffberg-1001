+#if ENABLE_I2S_TONE_TEST
+/*
+ * Amp diagnostic: 440 Hz for 0.2s (SD HIGH), then 0.3s hard mute (SD LOW).
+ * Rhythm of real quiet gaps = SD+I2S path OK.
+ * Continuous squeal even in "off" = SD not on GPIO17, or BCLK/DIN contact mess.
+ */
+static void esp32_i2s_tone_task(void *args)
+{
+    ESP_I2S_HANDLE_T *hdl = (ESP_I2S_HANDLE_T *)args;
+    const int frames = 256;
+    /* Philips 32-bit stereo: 2 int32 samples per frame (L=R). */
+    int32_t *buf = (int32_t *)tal_malloc(frames * 2 * sizeof(int32_t));
+    if (!buf) {
+        PR_ERR("tone buf alloc failed");
+        return;
+    }
+
+    float ph = 0.0f;
+    const float step = 2.0f * 3.14159265f * 440.0f / 16000.0f;
+    uint32_t sample_i = 0;
+    const uint32_t period = 16000 / 2; /* 0.5 s */
+    const uint32_t on_len = 16000 / 5; /* 0.2 s */
+    bool last_on = false;
+
+    PR_NOTICE("=== I2S RHYTHM+SD-MUTE 440Hz (0.2s on/0.3s SD-LOW) ===");
+
+    for (;;) {
+        bool any_on = false;
+        for (int i = 0; i < frames; i++) {
+            float s = 0.0f;
+            uint32_t pos = sample_i % period;
+            bool on = (pos < on_len);
+            if (on) {
+                any_on = true;
+                s = sinf(ph) * 0.45f;
+                ph += step;
+                if (ph > 6.2831853f) {
+                    ph -= 6.2831853f;
+                }
+            }
+            sample_i++;
+            int32_t s32 = (int32_t)(s * 2147483647.0f);
+            buf[2 * i] = s32;
+            buf[2 * i + 1] = s32;
+        }
+        /* Hard mute in gaps — continuous noise here means SD wiring wrong. */
+        if (any_on != last_on) {
+            __spk_sd_set(hdl, any_on);
+            last_on = any_on;
+        }
+        tkl_i2s_send(hdl->i2s_tx_id, buf, (uint32_t)(frames * 2 * sizeof(int32_t)));
+    }
+}
+#endif
