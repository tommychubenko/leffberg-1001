+static void __spk_sd_set(ESP_I2S_HANDLE_T *hdl, bool enable)
+{
+    if (NULL == hdl || hdl->cfg.spk_sd_pin >= TUYA_GPIO_NUM_MAX) {
+        return;
+    }
+    hdl->spk_on = enable;
+    tkl_gpio_write(hdl->cfg.spk_sd_pin, enable ? TUYA_GPIO_LEVEL_HIGH : TUYA_GPIO_LEVEL_LOW);
+}
+
+#if ENABLE_MIC_LOOPBACK_STATS
+#define LB_WIN_SAMPLES (1600) /* 100 ms @ 16 kHz */
+#define LB_NUM_FREQ    (6)
+/* chime notes 659 / 523 Hz at 1x, 2x, 3x playback speed (rate-mismatch check) */
+static const float s_lb_freq[LB_NUM_FREQ] = {659.0f, 523.0f, 1318.0f, 1046.0f, 1977.0f, 1569.0f};
+
+/* Static state: the read task runs on a 1 KB-class stack. */
+static struct {
+    float coeff[LB_NUM_FREQ];
+    float s1[LB_NUM_FREQ], s2[LB_NUM_FREQ];
+    uint64_t sq;
+    int64_t sum_raw; /* for DC estimate */
+    int32_t raw_min, raw_max;
+    uint32_t zc;
+    uint32_t n;
+    float hp_x1, hp_y1; /* one-pole DC blocker state */
+    float prev;
+    uint8_t tail; /* keep logging a few windows after mute to catch the decay */
+    bool inited;
+} s_lb;
+
+static void __mic_loopback_feed(ESP_I2S_HANDLE_T *hdl, const int16_t *x, uint32_t n)
+{
+    if (!s_lb.inited) {
+        for (int k = 0; k < LB_NUM_FREQ; k++) {
+            s_lb.coeff[k] = 2.0f * cosf(2.0f * 3.14159265f * s_lb_freq[k] / 16000.0f);
+        }
+        s_lb.raw_min = INT32_MAX;
+        s_lb.raw_max = INT32_MIN;
+        s_lb.inited = true;
+    }
+
+    if (hdl->spk_on) {
+        s_lb.tail = 3;
+    } else if (s_lb.tail == 0) {
+        /* speaker idle: keep detectors reset, no logging */
+        s_lb.n = 0;
+        s_lb.sq = 0;
+        s_lb.sum_raw = 0;
+        s_lb.raw_min = INT32_MAX;
+        s_lb.raw_max = INT32_MIN;
+        s_lb.zc = 0;
+        for (int k = 0; k < LB_NUM_FREQ; k++) {
+            s_lb.s1[k] = s_lb.s2[k] = 0.0f;
+        }
+        return;
+    }
+
+    for (uint32_t i = 0; i < n; i++) {
+        s_lb.sum_raw += x[i];
+        if (x[i] < s_lb.raw_min) {
+            s_lb.raw_min = x[i];
+        }
+        if (x[i] > s_lb.raw_max) {
+            s_lb.raw_max = x[i];
+        }
+        /* DC blocker (~20 Hz corner): AC part is what the ear would hear */
+        float xin = (float)x[i];
+        float v = xin - s_lb.hp_x1 + 0.992f * s_lb.hp_y1;
+        s_lb.hp_x1 = xin;
+        s_lb.hp_y1 = v;
+        s_lb.sq += (uint64_t)(v * v);
+        if ((v < 0.0f) != (s_lb.prev < 0.0f)) {
+            s_lb.zc++;
+        }
+        s_lb.prev = v;
+        for (int k = 0; k < LB_NUM_FREQ; k++) {
+            float s = v + s_lb.coeff[k] * s_lb.s1[k] - s_lb.s2[k];
+            s_lb.s2[k] = s_lb.s1[k];
+            s_lb.s1[k] = s;
+        }
+        s_lb.n++;
+    }
+
+    if (s_lb.n >= LB_WIN_SAMPLES) {
+        /* Goertzel power normalised so that a pure tone at f gives ~100 */
+        float norm = (float)s_lb.sq * (float)s_lb.n * 0.5f + 1.0f;
+        unsigned pct[LB_NUM_FREQ];
+        for (int k = 0; k < LB_NUM_FREQ; k++) {
+            float p = s_lb.s1[k] * s_lb.s1[k] + s_lb.s2[k] * s_lb.s2[k] - s_lb.coeff[k] * s_lb.s1[k] * s_lb.s2[k];
+            float r = p / norm * 100.0f;
+            pct[k] = (r < 0.0f) ? 0u : (r > 999.0f ? 999u : (unsigned)r);
+            s_lb.s1[k] = s_lb.s2[k] = 0.0f;
+        }
+        int rms = (int)sqrt((double)s_lb.sq / (double)s_lb.n);
+        int dc = (int)(s_lb.sum_raw / (int64_t)s_lb.n);
+        PR_NOTICE("mic loopback: spk=%d dc=%d min=%d max=%d | ac_rms=%d zc_pct=%u tone_pct: 659=%u 523=%u | 2x: 1318=%u "
+                  "1046=%u | 3x: 1977=%u 1569=%u",
+                  (int)hdl->spk_on, dc, (int)s_lb.raw_min, (int)s_lb.raw_max, rms, (unsigned)(s_lb.zc * 100u / s_lb.n),
+                  pct[0], pct[1], pct[2], pct[3], pct[4], pct[5]);
+        s_lb.n = 0;
+        s_lb.sq = 0;
+        s_lb.sum_raw = 0;
+        s_lb.raw_min = INT32_MAX;
+        s_lb.raw_max = INT32_MIN;
+        s_lb.zc = 0;
+        if (!hdl->spk_on && s_lb.tail) {
+            s_lb.tail--;
+        }
+    }
+}
+#endif
