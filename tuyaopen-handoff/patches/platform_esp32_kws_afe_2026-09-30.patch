+void auio_afe_wakenet_set(bool enable)
+{
+    /* Name kept for call sites: enable=true → IDLE (VAD off); false → LISTEN (VAD on).
+     * WakeNet itself lives in tkl_kws (standalone). */
+    if (false == sg_afe_proce.is_init || NULL == sg_afe_proce.afe_iface ||
+        NULL == sg_afe_proce.afe_data) {
+        return;
+    }
+
+    int rc_vad = -1;
+    if (enable) {
+        if (sg_afe_proce.afe_iface->disable_vad) {
+            rc_vad = sg_afe_proce.afe_iface->disable_vad(sg_afe_proce.afe_data);
+        }
+        ESP_LOGI(TAG, "afe mode IDLE: vad OFF (rc=%d)", rc_vad);
+    } else {
+        if (sg_afe_proce.afe_iface->enable_vad) {
+            rc_vad = sg_afe_proce.afe_iface->enable_vad(sg_afe_proce.afe_data);
+        }
+        if (sg_afe_proce.afe_iface->reset_vad) {
+            sg_afe_proce.afe_iface->reset_vad(sg_afe_proce.afe_data);
+        }
+        ESP_LOGI(TAG, "afe mode LISTEN: vad ON (rc=%d)", rc_vad);
+    }
 }
 
