+def _espressif_cmake_exe() -> Optional[str]:
+    """Windows fallback when the pip cmake launcher is blocked by WDAC/Smart App Control."""
+    if sys.platform != "win32":
+        return None
+    candidates = [
+        os.environ.get("OPEN_SDK_CMAKE"),
+        r"C:\Espressif\tools\cmake\3.30.2\bin\cmake.exe",
+        os.path.expandvars(r"%USERPROFILE%\cmake\bin\cmake.exe"),
+    ]
+    for path in candidates:
+        if path and os.path.isfile(path) and _tool_runs_ok(path):
+            return path
+    return None
+
